{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenrestore.local/schemas/geometry.schema.json",
  "title": "ScreenRestore QuadLocator geometry sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "split",
    "group_id",
    "capture_session",
    "device",
    "present",
    "target_class",
    "content_quad",
    "outer_quad",
    "visible",
    "occlusion",
    "glare_level"
  ],
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "capture_session": {
      "type": "string",
      "minLength": 1
    },
    "scene_group_id": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "present": {
      "type": "boolean"
    },
    "target_class": {
      "enum": [
        "artwork",
        "postcard",
        "screen",
        "none"
      ]
    },
    "content_quad": {
      "$ref": "#/$defs/nullable_quad"
    },
    "outer_quad": {
      "$ref": "#/$defs/nullable_quad"
    },
    "visible": {
      "type": "boolean"
    },
    "occlusion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "glare_level": {
      "enum": [
        "none",
        "light",
        "medium",
        "strong"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "scene_type": {
      "type": "string",
      "minLength": 1
    },
    "in_scope": {
      "type": "boolean"
    },
    "ambiguous": {
      "type": "boolean"
    },
    "unusable": {
      "type": "boolean"
    },
    "digital_source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_capture_id": {
      "type": "string",
      "minLength": 1
    },
    "source_license": {
      "type": "string",
      "minLength": 1
    },
    "source_adaptation": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "postcard",
        "artwork",
        "screen",
        "poster"
      ]
    },
    "capture_conditions": {
      "type": "array",
      "items": {
        "enum": [
          "frontal",
          "mild_perspective",
          "moderate_perspective",
          "near_border",
          "nested_layer",
          "weak_edge",
          "light_glare"
        ]
      },
      "uniqueItems": true
    },
    "overlay_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewed_at",
        "image_sha256",
        "annotation_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "annotation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scene_type": {
            "enum": [
              "gallery_multi_target",
              "multiple_artworks",
              "multiple_equally_plausible"
            ]
          }
        },
        "required": [
          "scene_type"
        ]
      },
      "then": {
        "required": [
          "ambiguous",
          "in_scope"
        ],
        "properties": {
          "present": {
            "const": false
          },
          "target_class": {
            "const": "none"
          },
          "content_quad": {
            "type": "null"
          },
          "outer_quad": {
            "type": "null"
          },
          "visible": {
            "const": false
          },
          "ambiguous": {
            "const": true
          },
          "in_scope": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "quad": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "nullable_quad": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/quad"
        }
      ]
    }
  }
}
